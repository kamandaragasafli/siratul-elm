# OpenAI — hifz səs yoxlaması (Whisper + GPT, təcvid konteksti)
OPENAI_API_KEY=

# Neon Postgres (Render production) — yoxdursa lokal SQLite
# https://console.neon.tech/ → Connection string → Pooled
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# YouTube yt-dlp
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# PO token provider (bgutil) — prefetch_audio üçün tövsiyə olunur
# YTDLP_PO_PROVIDER_URL=http://127.0.0.1:4416

# Telegram — tətbiqdən sual göndərmə (Sirac sual qrupu)
# Bot: @BotFather → token; qrupa admin əlavə edin; chat ID: getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_QA_CHAT_ID=

# LiveKit Cloud (https://cloud.livekit.io) — APK canlı yayım üçün mütləq
# Project → Settings → Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# məs: wss://your-project.livekit.cloud
LIVEKIT_SERVER_URL=

# Supabase Storage — PDF / media (Render disk ephemeral; AWS lazım deyil)
# Dashboard → Project Settings → Storage → S3 access keys
# Storage → New bucket → adı: media → Public
# USE_SUPABASE_STORAGE=1
# SUPABASE_PROJECT_REF=
# SUPABASE_STORAGE_BUCKET=media
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_REGION=eu-central-1

# Cloudflare R2 (50 MB+ PDF üçün tövsiyə) — Supabase env-ləri SİL / boş burax
# https://dash.cloudflare.com → R2 → Create bucket → media
# Bucket → Settings → Public access → Allow Access → r2.dev subdomain kopyala
# R2 → Manage R2 API Tokens → Create → Object Read & Write
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxxxxxx.r2.dev

